# Telegram Credentials
BOT_TOKEN=your_bot_token_here
ADMIN_USER_ID=your_telegram_numeric_id_here

# Telethon MTProto API Credentials (https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telethon Source Chat (Optional, leave empty for private bot chats)
TELETHON_SOURCE_CHAT=

# Media Storage Directories (Host paths)
MOVIES_DIR=./media/movies
SHOWS_DIR=./media/shows

# Application Storage
SESSION_FILE=/app/data/telethon.session
SQLITE_PATH=/app/data/media_data.db
LOG_LEVEL=INFO

# Web Dashboard (Default username is 'admin', set password to secure)
WEB_PORT=8088
WEB_USERNAME=admin
WEB_PASSWORD=

# Media Server Auto-Scan (Optional)
JELLYFIN_URL=
JELLYFIN_API_KEY=
PLEX_URL=
PLEX_TOKEN=
